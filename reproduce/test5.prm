# Paper Table 1, Test 5: Geometry-B, p1=p2=2, RL-RBF, r_f=10 (the "large
# support radius" regime the paper identifies as the scalability bottleneck
# -- see resolutionAlgorithm.tex/NumericalResults §4.3's discussion of
# Step 2/Step 3 cost).
# Radius r = r_f * h_avg of each subdomain's own mesh ("RBF radius factor").
# Refinement levels found by matching the slave's DoF count: refinement 4
# gives exactly 202,818 DoFs, i.e. Table 1's slave target (~2.02e5); master
# at one level finer (5, the same master = slave + 1 convention as Tests
# 1-3) extrapolates to ~1.62e6, close to Table 1's master target (~1.59e6).

subsection Geometry
  set Type                     = hyper_shells
  set Inner radius             = 0.5
  set Interface radius         = 0.75
  set Outer radius             = 1.0
  set Shell refinement master  = 5
  set Shell refinement slave   = 4
end

subsection Discretization
  set Master degree = 2
  set Slave degree  = 2
  set RBF radius        = 0.0
  set RBF radius factor = 50
end

subsection Boundary conditions
  set Dirichlet ids master = 0
  set Neumann ids master   =
  set Interface id master  = 1
  set Dirichlet ids slave = 1
  set Neumann ids slave   =
  set Interface id slave  = 0
end

subsection Solver
  set GMRES tolerance      = 1e-14
  set GMRES reduction      = 1e-8
  set GMRES max iterations = 1000
end
