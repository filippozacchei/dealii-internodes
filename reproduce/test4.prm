# Paper Table 4, Test 4: Geometry-B, p1=p2=1, RL-RBF, r_f=1.
# Radius r = r_f * h_avg of each subdomain's own mesh ("RBF radius factor").
# Reference DoF counts: ~1.26e7 (master), ~1.59e6 (slave); see caveat in
# reproduce/README.md -- shell refinement levels here are a placeholder.

subsection Geometry
  set Type                     = half_hyper_shells
  set Inner radius             = 0.5
  set Interface radius         = 0.75
  set Outer radius             = 1.0
  set Shell refinement master  = 5
  set Shell refinement slave   = 4
end

subsection Discretization
  set Master degree = 1
  set Slave degree  = 1
  set RBF radius        = 0.0
  set RBF radius factor = 1
end

subsection Boundary conditions
  # half_hyper_shell colorization: 0 = inner surface, 1 = outer surface,
  # 2 = flat cut face(s). Master occupies [inner,interface], slave occupies
  # [interface,outer] -- so master's outer surface (radius=interface) and
  # slave's inner surface (radius=interface) are the shared curved
  # interface.
  set Dirichlet ids master = 0
  set Neumann ids master   = 2
  set Interface id master  = 1
  set Dirichlet ids slave = 1
  set Neumann ids slave   = 2
  set Interface id slave  = 0
end

subsection Solver
  set GMRES tolerance      = 1e-14
  set GMRES reduction      = 1e-8
  set GMRES max iterations = 1000
end
