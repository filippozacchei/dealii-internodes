# Paper Table 1, Test 4: Geometry-B, p1=p2=1, RL-RBF, r_f=1.
# Radius r = r_f * h_avg of each subdomain's own mesh ("RBF radius factor").
# Refinement levels found by matching the slave's DoF count: refinement 6
# gives exactly 1,597,570 DoFs, i.e. Table 1's slave target (~1.59e6); master
# at one level finer (7, the same master = slave + 1 convention as Tests
# 1-3) extrapolates to ~1.25e7, close to Table 1's master target (~1.26e7).

subsection Geometry
  set Type                     = hyper_shells
  set Inner radius             = 0.5
  set Interface radius         = 0.75
  set Outer radius             = 1.0
  set Shell refinement master  = 7
  set Shell refinement slave   = 6
end

subsection Discretization
  set Master degree = 1
  set Slave degree  = 1
  set RBF radius        = 0.0
  set RBF radius factor = 1
end

subsection Boundary conditions
  # hyper_shell colorization (full shell, not cut by a plane): 0 = inner
  # surface, 1 = outer surface -- no other boundary. Master occupies
  # [inner,interface], slave occupies [interface,outer] -- so master's outer
  # surface (radius=interface) and slave's inner surface (radius=interface)
  # are the shared, independently meshed curved interface.
  set Dirichlet ids master = 0
  set Neumann ids master   =
  set Interface id master  = 1
  set Dirichlet ids slave = 1
  set Neumann ids slave   =
  set Interface id slave  = 0
end

subsection Solver
  set GMRES tolerance      = 1e-14
  set GMRES reduction      = 1e-8
  set GMRES max iterations = 1000
end
