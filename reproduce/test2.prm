# Paper Table 4, Test 2: Geometry-A, p1=p2=1, RL-RBF interpolation, r_f=1.
# radius = r_f * h_2 = 1 * 2.70e-3 = 2.70e-3.
# Reference DoF counts: ~1.69e7 (master), ~2.14e5 (slave); see caveat in
# reproduce/README.md -- subdivisions here are a placeholder.

subsection Geometry
  set Type                = adjacent_boxes
  set Subdivisions master = 64,32,32
  set Subdivisions slave  = 32,16,16
end

subsection Discretization
  set Master degree = 1
  set Slave degree  = 1
  set RBF radius    = 2.70e-3
end

subsection Boundary conditions
  set Dirichlet ids master = 0
  set Neumann ids master   = 2,3,4,5
  set Interface id master  = 1
  set Dirichlet ids slave = 1
  set Neumann ids slave   = 2,3,4,5
  set Interface id slave  = 0
end

subsection Solver
  set GMRES tolerance      = 1e-8
  set GMRES max iterations = 1000
end
