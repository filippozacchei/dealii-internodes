# Paper Table 4, Test 3: Geometry-A, p1=2, p2=4 (mixed order), RL-RBF, r_f=1.
# Radius r = r_f * h_avg of each subdomain's own mesh ("RBF radius factor").
# Meshes: a single coarse cube per subdomain, refined 7 (master, P2) and 5
# (slave, P4) times, as in the paper's scaling figures ("p2r7-p4r5"). DoFs:
# 257^3 = 1.70e7 (master) and 129^3 = 2.15e6 (slave; Table 4 lists 2.14e5).
# The master mesh is 4x finer than the slave's, with P2 against P4: a test
# of a polynomial-degree AND mesh-size mismatch across the interface.

subsection Geometry
  set Type                = adjacent_boxes
  set Subdivisions master = 1,1,1
  set Subdivisions slave  = 1,1,1
  set Global refinement master = 7
  set Global refinement slave  = 5
end

subsection Discretization
  set Master degree = 2
  set Slave degree  = 4
  set RBF radius        = 0.0
  set RBF radius factor = 1
end

subsection Boundary conditions
  set Dirichlet ids master = 0
  set Neumann ids master   = 2,3,4,5
  set Interface id master  = 1
  set Dirichlet ids slave = 1
  set Neumann ids slave   = 2,3,4,5
  set Interface id slave  = 0
end

subsection Solver
  set GMRES tolerance      = 1e-8
  set GMRES max iterations = 1000
end
