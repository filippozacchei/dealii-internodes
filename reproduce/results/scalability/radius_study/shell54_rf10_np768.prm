subsection Geometry
  set Type = hyper_shells
  set Inner radius = 0.5
  set Interface radius = 0.75
  set Outer radius = 1.0
  set Shell refinement master = 5
  set Shell refinement slave = 4
end

subsection Discretization
  set Master degree = 2
  set Slave degree = 2
  set RBF radius = 0.0
  set RBF radius factor = 10
end

subsection Boundary conditions
  set Dirichlet ids master = 0
  set Neumann ids master = 
  set Interface id master = 1
  set Dirichlet ids slave = 1
  set Neumann ids slave = 
  set Interface id slave = 0
end

subsection Solver
  set GMRES tolerance = 1e-14
  set GMRES reduction = 1e-8
  set GMRES max iterations = 1000
end

subsection Run
  set Results file = /g100_work/uBS26_MatGer/dealii-internodes/reproduce/results/scalability/radius_study/shell54_rf10_np768.json
end
