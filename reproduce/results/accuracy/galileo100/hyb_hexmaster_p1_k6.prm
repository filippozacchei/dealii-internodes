subsection Geometry
  set Type = adjacent_boxes
  set Subdivisions master = 1,1,1
  set Subdivisions slave = 1,1,1
  set Global refinement master = 6
  set Global refinement slave = 5
  set Cell type master = hex
  set Cell type slave = tet
end

subsection Discretization
  set Master degree = 1
  set Slave degree = 1
  set RBF radius = 0.0
  set RBF radius factor = 1
end

subsection Solver
  set GMRES tolerance = 1e-14
  set GMRES reduction = 1e-08
  set GMRES max iterations = 2000
  set Use Schur preconditioner = true
end

subsection Run
  set Mode = coupled
  set Results file = /g100_work/uBS26_MatGer/dealii-internodes/reproduce/results/accuracy/galileo100/hyb_hexmaster_p1_k6.json
end
