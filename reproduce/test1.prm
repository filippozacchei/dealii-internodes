# Paper Table 4, Test 1: Geometry-A, p1=p2=1, Lagrange interpolation.
# Meshes: a single coarse cube per subdomain, refined globally 8 (master) and
# 7 (slave) times, i.e. 256^3 and 128^3 cells, so h_2 = 2 h_1. The levels are
# those of the paper's scaling figures ("p1r8-p1r7"). DoFs: 257^3 = 1.70e7
# (master, Table 4: 1.69e7) and 129^3 = 2.15e6 (slave; Table 4 lists 2.14e5,
# which looks like a typo for 2.14e6). See reproduce/README.md.

subsection Geometry
  set Type                = adjacent_boxes
  set Subdivisions master = 1,1,1
  set Subdivisions slave  = 1,1,1
  set Global refinement master = 8
  set Global refinement slave  = 7
end

subsection Discretization
  set Master degree = 1
  set Slave degree  = 1
  set RBF radius    = 0.0
end

subsection Boundary conditions
  set Dirichlet ids master = 0
  set Neumann ids master   = 2,3,4,5
  set Interface id master  = 1
  set Dirichlet ids slave = 1
  set Neumann ids slave   = 2,3,4,5
  set Interface id slave  = 0
end

subsection Solver
  set GMRES tolerance      = 1e-8
  set GMRES max iterations = 1000
end
